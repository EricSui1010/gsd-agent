{"version": 2, "project": {"name": "GSD Agent", "description": "AI Code Management Agent with CodeGraph Integration", "version": "1.0"}, "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.py", "**/*.md"], "exclude": ["**/.git/**", "**/node_modules/**", "**/dist/**", "**/build/**", "**/.codegraph/**", "**/*.min.js", "**/*.bundle.js"], "indexing": {"maxFileSize": 524288, "extractDocstrings": true, "trackCallSites": true, "enableTypeInference": true, "followSymbolicLinks": false}, "performance": {"cacheEnabled": true, "cacheTTL": 3600000, "queryTimeout": 30000, "maxConcurrentQueries": 5}, "features": {"contextModeV2": {"enabled": true, "maxDepth": 3, "maxNodes": 50, "tokenBudget": 1000, "includeDependencies": true, "includeCallers": true}, "impactAnalysis": {"enabled": true, "maxDepth": 4, "includeIndirect": true, "generateRecommendations": true}, "smartSearch": {"enabled": true, "fuzzyMatching": true, "rankByRelevance": true, "includeTypeInformation": true}}, "mcp": {"enabled": true, "tools": ["context", "callers", "impact", "search", "references"], "auth": {"enabled": false}}}